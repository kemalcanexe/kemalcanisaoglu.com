---
import Base from '../layouts/Base.astro';
import Console from './Console.astro';
import Dialogs from './Dialogs.astro';
import { dict, LINKS, type Lang } from '../i18n/content';
import { KEYS } from '../data/keys';
import { ICONS } from '../data/icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
const face = (id: string) => KEYS.find((k) => k.id === id)!;
const work = [
  { id: 'insider', ...t.work.insider },
  { id: 'portakasa', ...t.work.portakasa },
] as const;
---
<Base lang={lang}>
  <a class="skip" href="#main">{t.nav.skip}</a>

  <div class="glow" aria-hidden="true" data-glow></div>

  <header class="top">
    <a class="mark" href={lang === 'en' ? '/' : '/tr/'} aria-label="Kemal Can İsaoğlu">
      <span class="mark-scr" aria-hidden="true" translate="no"><span class="mark-txt" data-mark data-marks={JSON.stringify(t.marks)}>KCİ</span><span class="mark-car"></span></span>
      <span class="mark-name" aria-hidden="true">Kemal Can İsaoğlu<span>{t.nav.role}</span></span>
    </a>
    <nav class="nav" aria-label={t.nav.menu}>
      <a href="#work">{t.nav.work}</a>
      <a href="#about" data-open="about">{t.nav.about}</a>
      <a href="#experience">{t.nav.experience}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>
    <div class="top-tools">
      <button type="button" class="icon-btn" data-sound aria-pressed="false" aria-label={t.nav.sound}
              data-on={t.nav.soundOn} data-off={t.nav.soundOff}>
        <span class="i-on" set:html={ICONS.sound} /><span class="i-off" set:html={ICONS.mute} />
      </button>
      <a class="lang" href={t.nav.langHref} hreflang={lang === 'en' ? 'tr' : 'en'} lang={lang === 'en' ? 'tr' : 'en'} aria-label={t.nav.langLabel}>{t.nav.lang}</a>
      <a class="talk" href="#contact" data-open="contact">{t.nav.talk}</a>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="hero-title">{t.hero.name}<span>.</span></h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <ul class="hero-stats">{t.hero.stats.map((st) => <li><b>{st.n}</b> {st.label}</li>)}</ul>
      <Console lang={lang} />
    </section>

    <section class="work" id="work" aria-labelledby="work-title">
      <h2 id="work-title" class="sec-title">{t.work.heading}</h2>
      <div class="work-grid">
        {work.map((w) => {
          const k = face(w.id);
          return (
            <article class={`plate plate-${w.id}`} style={`--face:${k.face};--edge:${k.edge};--ink:${k.ink}`}>
              <div class="plate-head">
                <span class="plate-cap" set:html={ICONS[w.id]} aria-hidden="true" />
                <div>
                  <h3>{w.name}</h3>
                  <p class="plate-role">{w.role} <span>{w.when}</span></p>
                </div>
              </div>
              <p class="plate-line">{w.line}</p>
              {w.stats.length > 0 && (
                <dl class="plate-stats">
                  {w.stats.map((s) => (<div><dt>{s.n}</dt><dd>{s.label}</dd></div>))}
                </dl>
              )}
              <ul class="plate-points">{w.points.map((p) => <li>{p}</li>)}</ul>
              <button type="button" class="btn btn-face" data-open={w.id} aria-haspopup="dialog">{w.cta}</button>
            </article>
          );
        })}
      </div>
    </section>

    <section class="exp" id="experience" aria-labelledby="exp-title">
      <h2 id="exp-title" class="sec-title">{t.timeline.heading}</h2>
      {t.timeline.groups.map((g) => (
        <div class="tl-group">
          <h3 class="tl-group-title">{g.title}</h3>
          <ol class="timeline">
            {g.items.map((it) => {
              const k = it.key ? face(it.key) : undefined;
              const deep = it.key && ['insider', 'portakasa', 'icron'].includes(it.key);
              return (
                <li class={`tl-item${deep ? ' deep' : ''}`} style={k ? `--face:${k.face};--edge:${k.edge}` : ''}>
                  <p class="tl-when">{it.when}{it.place && <span>{it.place}</span>}</p>
                  <div class="tl-body">
                    <h4 class="tl-what">{it.what}</h4>
                    <p class="tl-where">{it.where}</p>
                    <ul class="tl-points">{it.points.map((pt) => <li>{pt}</li>)}</ul>
                    {deep && <button type="button" class="tl-more" data-open={it.key} aria-haspopup="dialog" aria-label={`${t.dialog.open}: ${it.where}`}>{t.dialog.open}</button>}
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">{t.contact.heading}</h2>
      <div class="contact-side">
        <p>{t.contact.text}</p>
        <div class="contact-actions">
          <a class="email" href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
          <button type="button" class="btn btn-ghost" data-copy={LINKS.email} data-copied={t.contact.copied}>
            <span set:html={ICONS.copy} /><span data-copy-label>{t.contact.copy}</span>
          </button>
        </div>
        <div class="contact-actions">
          <a class="btn" href={LINKS.linkedin} target="_blank" rel="noopener"><span set:html={ICONS.linkedin} />{t.contact.linkedin}</a>
          <a class="btn" href={LINKS.cv} download="Kemal-Can-Isaoglu-CV.pdf"><span set:html={ICONS.download} />{t.contact.cv}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <span>© 2026 {t.footer}</span>
    <a href={t.nav.langHref} hreflang={lang === 'en' ? 'tr' : 'en'}>{t.nav.langLabel}</a>
  </footer>

  <nav class="dock" data-dock aria-label={t.nav.menu}>
    <a href="#work">{t.nav.work}</a>
    <a href="#about" data-open="about">{t.nav.about}</a>
    <a href="#experience">{t.nav.experience}</a>
    <a href="#contact" class="dock-talk" data-open="contact">{t.nav.talk}</a>
  </nav>

  <Dialogs lang={lang} />

  <!-- iOS 18+ gives haptic feedback when a switch toggles; used for key taps. -->
  <label class="haptic" aria-hidden="true" data-haptic><input type="checkbox" {...{ switch: true }} tabindex="-1" /></label>

  <div class="sr-only" role="status" aria-live="polite" data-live></div>

  <script>
    import '../scripts/main.ts';
  </script>
</Base>

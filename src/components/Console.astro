---
import { Picture, getImage } from 'astro:assets';
import device from '../assets/device.png';
import { KEYS, pct } from '../data/keys';
import type { ImageMetadata } from 'astro';
import { dict, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];

// Photoreal keycaps, pre-rendered (tools/keycaps) with the photo's camera and light.
const capFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/keys/*/*.png', { eager: true });
const capImg = (id: string) => capFiles[`../assets/keys/${lang}/${id}.png`].default;
const CAP_W = { lg: [160, 240, 320, 480, 640], sm: [120, 180, 240, 360, 480], bar: [400, 600, 800, 1200, 1600] } as const;
const CAP_SIZES = { lg: 'min(14vw, 200px)', sm: 'min(9vw, 130px)', bar: 'min(32vw, 460px)' } as const;

// Low-res alpha copy used only as a mask for the moving light.
const mask = await getImage({ src: device, width: 640, format: 'webp', quality: 60 });

const screenData = {
  idle: { title: t.screen.title, desc: t.screen.desc },
  keys: Object.fromEntries(Object.entries(t.keys).map(([k, v]) => [k, { title: v.screen, desc: v.desc }])),
  status: { typing: t.screen.typing, ready: t.screen.ready },
  term: t.term,
};
---
<div class="console" data-console style={`--mask:url(${mask.src})`}>
  <div class="tilt" data-tilt>
    <Picture
      src={device}
      formats={['avif', 'webp']}
      quality={78}
      widths={[480, 768, 1024, 1280, 1536]}
      sizes="(max-width: 640px) 132vw, min(1640px, 116vw)"
      alt=""
      class="device-img"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      draggable="false"
    />
    <div class="sheen" aria-hidden="true"><div class="sheen-light" data-sheen></div></div>

    <div class="screen" data-screen>
      <div class="screen-glass">
        <div class="scr-meta" aria-hidden="true">
          <span>{t.screen.meta.split(' / ')[0]}<span class="scr-meta-extra"> / {t.screen.meta.split(' / ').slice(1).join(' / ')}</span></span>
          <span class="scr-status" data-status>{t.screen.ready}</span>
        </div>
        <p class="scr-title">
          <span class="sr-only" data-title>{t.screen.title}</span><span data-typed aria-hidden="true">{t.screen.title}</span><span class="caret" aria-hidden="true"></span>
        </p>
        <p class="scr-desc" data-desc>{t.screen.desc}</p>
        <form class="scr-term" data-term autocomplete="off">
          <label class="sr-only" for="term-input">{t.screen.prompt}</label>
          <span aria-hidden="true">›</span>
          <input id="term-input" data-term-input type="text" spellcheck="false" autocapitalize="off" enterkeyhint="go" placeholder={t.screen.hint} maxlength="40" />
        </form>
      </div>
    </div>

    <nav class="keys" aria-label={t.device.label}>
      {KEYS.map((k, i) => {
        const p = pct(k);
        const style = `--l:${p.left}%;--t:${p.top}%;--w:${p.width}%;--h:${p.height}%;--i:${i}`;
        const label = t.keys[k.id].label;
        const inner = (
          <Fragment>
            <span class="key-led" aria-hidden="true"></span>
            <span class="key-shadow" aria-hidden="true"></span>
            <span class="key-cap" aria-hidden="true">
              <Picture src={capImg(k.id)} formats={['avif', 'webp']} widths={[...CAP_W[k.size]]} sizes={CAP_SIZES[k.size]} quality={90}
                       alt="" loading="eager" decoding="async" draggable="false" class="key-img" />
            </span>
          </Fragment>
        );
        return k.href ? (
          <a class={`key key-${k.size}`} href={k.href} data-key={k.id} data-shortcut={k.shortcut} style={style}
             aria-label={label} {...(k.external ? { target: '_blank', rel: 'noopener' } : {})} {...(k.download ? { download: 'Kemal-Can-Isaoglu-CV.pdf' } : {})}>{inner}</a>
        ) : (
          <button type="button" class={`key key-${k.size}`} data-key={k.id} data-open={k.id} data-shortcut={k.shortcut}
                  style={style} aria-label={label} aria-haspopup="dialog">{inner}</button>
        );
      })}
    </nav>
  </div>
  <script type="application/json" data-screen-json set:html={JSON.stringify(screenData)} />
</div>

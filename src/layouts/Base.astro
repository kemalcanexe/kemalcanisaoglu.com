---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
import '../styles/global.css';
import bricoUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource/courier-prime/files/courier-prime-latin-700-normal.woff2?url';
import { dict, LINKS, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
const site = 'https://kemalcanisaoglu.com';
const url = lang === 'en' ? `${site}/` : `${site}/tr/`;
const og = `${site}/og.jpg`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kemal Can İsaoğlu',
  url: site,
  email: `mailto:${LINKS.email}`,
  jobTitle: lang === 'en' ? 'Product Management Intern' : 'Ürün Yönetimi Stajyeri',
  worksFor: [{ '@type': 'Organization', name: 'Insider One' }, { '@type': 'Organization', name: 'Portakasa' }],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Koç University' },
  address: { '@type': 'PostalAddress', addressLocality: 'Istanbul', addressCountry: 'TR' },
  sameAs: [LINKS.linkedin, LINKS.portakasa],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#111113" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href={`${site}/`} />
    <link rel="alternate" hreflang="tr" href={`${site}/tr/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    <link rel="preload" href={bricoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Kemal Can İsaoğlu" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'tr_TR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
